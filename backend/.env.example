# Secret used to sign login tokens. Make a long random value:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Leave empty to use a local SQLite file. For PostgreSQL (for example Neon),
# paste the connection string here.
DATABASE_URL=

# Public addresses of the frontend and backend (no slash at the end)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# Email sending (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Photo storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: error tracking (Sentry). Leave empty to turn it off.
SENTRY_DSN=